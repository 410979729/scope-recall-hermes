{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entity_view",
  "description": "Exact one-hop evidence-grounded entity view. Design specification v1.1. Not an installed API. value_text is the recorded scalar object, not a canonical entity id.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "ok",
        "no_match",
        "partial",
        "unavailable"
      ]
    },
    "memory_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "resolved_subject": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 240
    },
    "alias_resolution": {
      "enum": [
        "literal",
        "resolved",
        "ambiguous",
        "none"
      ]
    },
    "action": {
      "enum": [
        "probe",
        "related"
      ]
    },
    "direction": {
      "enum": [
        "outgoing",
        "incoming",
        "both"
      ]
    },
    "statements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction",
          "subject",
          "predicate",
          "value_text",
          "ref",
          "revision",
          "kind",
          "conditions",
          "temporal_status",
          "claim_state",
          "valid_from",
          "valid_to",
          "evidence_refs",
          "basis"
        ],
        "properties": {
          "direction": {
            "enum": [
              "outgoing",
              "incoming"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "value_text": {
            "type": "string",
            "maxLength": 8192
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "fact",
              "preference",
              "constraint",
              "decision",
              "intention"
            ]
          },
          "conditions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "temporal_status": {
            "enum": [
              "current",
              "historical",
              "disputed",
              "unknown"
            ]
          },
          "claim_state": {
            "enum": [
              "active",
              "disputed"
            ]
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "basis": {
            "enum": [
              "direct_report",
              "observed",
              "derived_summary",
              "inferred_suggestion",
              "unknown"
            ]
          },
          "source_contexts": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "chat_type"
              ],
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "chat_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "coverage": {
      "enum": [
        "complete_for_query",
        "partial",
        "unknown"
      ]
    },
    "answerability": {
      "enum": [
        "supported",
        "partial",
        "ambiguous",
        "unknown"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "scan_capped": {
      "type": "boolean"
    },
    "unmet_needs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "status",
    "memory_epoch",
    "subject",
    "resolved_subject",
    "alias_resolution",
    "action",
    "direction",
    "statements",
    "gaps",
    "coverage",
    "answerability",
    "truncated",
    "scan_capped",
    "unmet_needs"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "no_match",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "statements": {
            "maxItems": 0
          },
          "answerability": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "statements": {
            "minItems": 1
          },
          "memory_epoch": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scan_capped": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "enum": [
              "partial",
              "unknown"
            ]
          }
        }
      }
    }
  ]
}
