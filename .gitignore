# Hermes local planning/session scratch.
.hermes/

# Local execution evidence and private audit artifacts.
.execution/

# Gate run receipts. `scripts/check.py` writes one `<tier>-<nanos>.log` and one
# `<tier>-<nanos>-inputs.json` per invocation, and a day of iterating leaves
# hundreds. The curated evidence bundles under verification/ stay tracked --
# they are what a claim cites -- but the exhaust of arriving at them is not
# evidence of anything, and 600 untracked files make `git status` useless for
# seeing what actually changed. Receipts already committed stay committed;
# .gitignore does not touch them.
verification/**/*-[0-9]*.log
verification/**/*-[0-9]*.json

# Verification receipts are evidence of a local gate run, not public material:
# the fleet inventory, the run logs and the provider receipts named machines,
# paths and credential entries. Only the files a gate reads stay tracked.
verification/*
!verification/README.md
!verification/functional_traceability.json
!verification/G0/
verification/G0/*
!verification/G0/g0-appserver-method-adjudication-v2.json
!verification/G0/g0-hermes-cli-method-adjudication-v1.json
