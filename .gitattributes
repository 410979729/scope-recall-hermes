# Windows working trees may use CRLF. Treat CR as a line terminator while
# preserving trailing-space, blank-at-EOF, and space-before-tab checks.
* whitespace=trailing-space,space-before-tab,cr-at-eol
verification/P07/** -text
verification/G0/evaluation-dataset-audit-v[3-6].json -text
verification/G1/** -text
verification/P08/** -text

# Normalize line endings: the repository stores LF; Windows agents committed CRLF once (rc21-rc26 standalone tree).
* text=auto eol=lf

# Evidence under verification/ is byte-exact: digests of these files are pinned in scripts/model_receipt_evidence.py
# and inside other evidence files. Never convert their line endings.
verification/** -text
