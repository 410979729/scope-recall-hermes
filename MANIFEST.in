include tests/test_journal_source_restore_package.py
include tests/test_journal_source_restore_planning.py
include tests/test_journal_source_restore_rows.py
include tests/test_journal_source_restore_snapshot.py
recursive-include .github/workflows *.yml
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
