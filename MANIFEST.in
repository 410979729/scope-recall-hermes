include README.md
include CHANGELOG.md
include LICENSE
include SECURITY.md
include CONTRIBUTING.md
include CONTRIBUTORS.md
include .env.example
include py.typed
recursive-include docs *.md
prune tests
recursive-include packaging_hooks *.py
include packaging/v11-module-allowlist.json
include scripts/check.py
include scripts/build.package_manifest.py
recursive-include .github/scripts *.py
recursive-include constraints *.txt
recursive-include .github/workflows *.yml
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
