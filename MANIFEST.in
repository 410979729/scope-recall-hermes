include plugin.yaml
include config.json
include README.md
include DESIGN.md
include CHANGELOG.md
include LICENSE
include SECURITY.md
include CONTRIBUTING.md
include CONTRIBUTORS.md
include .env.example
include py.typed
recursive-include docs *.md
prune docs/plans
prune tests
recursive-include _internal *.py
