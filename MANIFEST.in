include constraints/release.txt
include constraints/release-hashed.txt
include constraints/runtime-min.txt
include constraints/runtime-max.txt
recursive-include benchmarks *.json
recursive-include examples *.jsonl
include tests/plugin_source.py
include tests/conftest.py
include tests/journal_source_restore_oracles.py
include tests/journal_source_restore_support.py
include tests/test_journal_source_restore_apply.py
